<lint>
    <!--
      The bundled brand icons (Simple Icons, CC0) are single detailed paths drawn at 24 dp.
      Lint's size heuristic is for large illustrations; simplifying a trademarked logo would change it.
    -->
    <issue id="VectorPath">
        <ignore path="**/res/drawable/si_*.xml" />
    </issue>
    <!--
      Dependency freshness is Dependabot's job. A lint error for "a newer version exists" makes a green
      build go red on the day a library publishes a release, with no change in this repository.
    -->
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
</lint>
